AUTHOR = "Ubuntu"
NAME = 'ubuntu_kselftests_net'
CRITERIA = """
Uses built-in kernel repository self tests for net.
"""
SUITE = "None"
TIME = "SHORT"
TEST_CLASS = 'kernel'
TEST_CATEGORY = 'Functional'
TEST_TYPE = "client"
DOC = ""


categories = ['net']
arch = platform.machine()
arch_scale = 1
# Scale timeouts by 2 for riscv64, some tests timeout due to lack of
# timeout, despite progressing fine
if arch in ['riscv64']:
    arch_scale = 2

result = job.run_test_detail(NAME, test_name='setup', tag='setup', timeout=arch_scale*60*45)
if result == 'GOOD':
    for category in categories:
        build = '{}-build'.format(category)
        result = job.run_test_detail(NAME, test_name=build, tag=build, timeout=arch_scale*60*90)
        if result == 'ERROR':
            print("ERROR: test suite '{}' failed to build, skipping all the sub tests".format(category))
            continue
        mk_helper = os.path.join(job.testdir, NAME, 'helper.mk')
        dir_root = os.path.join(job.bindir, 'tmp', NAME, 'src', 'linux/tools/testing/selftests/')
        dir_src = os.path.join(dir_root, category)
        mk_src = os.path.join(dir_src, 'Makefile')
        os.chdir(dir_src)
        if os.path.isfile(mk_src):
            cmd = 'make -f {} -f {} gettests'.format(mk_src, mk_helper)
            tests = utils.system_output(cmd).split()
            for item in tests:
                timeout_threshold = arch_scale*60*45
                if item == 'fcnal-test.sh':
                    timeout_threshold = arch_scale*60*75  # lp:2006499, lp:2012016
                test = "{}:{}".format(category, item)
                job.run_test_detail(NAME, test_name=test, tag=test, timeout=timeout_threshold)
else:
    print("ERROR: test failed to build, skipping all the sub tests")

