AUTHOR = "Ubuntu"
NAME = "ubuntu_ltp_kernel_misc"
CRITERIA = """
Use the upstream LTP repository
"""
SUITE = "None"
TIME = "MEDIUM"
TEST_CLASS = 'kernel'
TEST_CATEGORY = 'Functional'
TEST_TYPE = "client"
DOC = ""

# This test will take about 50min to run on google cloud
result = job.run_test_detail(NAME, test_name='setup', tag='setup', timeout=60*40)
if result == 'GOOD':
    fn = '/opt/ltp/runtest/kernel_misc'
    with open(fn , 'r') as f:
        for line in f:
            if line.strip() and not line.startswith('#'):
                with open ('/tmp/target' , 'w') as t:
                    t.write(line)
                testcase = line.split()[0]
                if 'tpci' == testcase and 'kvm' in platform.release():
                    # Test results in an unkillable hang on KVM hosts
                    print('Skipping tpci on kvm flavours due to lp:1947422')
                    continue

                timeout_threshold = 60*20
                if testcase == 'zram01':
                    timeout_threshold = 60*30
                job.run_test_detail(NAME, test_name=testcase, tag=testcase, timeout=timeout_threshold)
else:
    print("ERROR: test failed to build, skipping all the sub tests")


