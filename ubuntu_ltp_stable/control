AUTHOR = "Ubuntu"
NAME = "ltp"
CRITERIA = """
Use the upstream LTP repository
"""
SUITE = "None"
TIME = "SHORT"
TEST_CLASS = 'kernel'
TEST_CATEGORY = 'Functional'
TEST_TYPE = "client"
DOC = ""

name = 'ubuntu_ltp_stable'

result = job.run_test_detail('ubuntu_ltp_stable', test_name='setup', tag='setup', timeout=60*50)
if result == 'GOOD':
    tests = [
        'fs_perms_simple', 'dio',
        'ipc',             'math',                   'nptl',         'containers',
        'fs_bind',         'fcntl-locktests',
        'power_management_tests', 'hugetlb',      'commands',
        'hyperthreading',  'can',                    'net.ipv6_lib', 'input'
    ]
    # dio test will take about 3.5 hours to run on Xilinx devices it's quite
    # easy to hit the 4h bar on jenkins, remove it from these slow devices
    if 'xilinx' in platform.release():
        print('dio test removed for xilinx kernel')
        tests.remove('dio')

    for test in tests:
        results = job.run_test_detail('ubuntu_ltp_stable', test_name=test, tag=test, timeout=60*30*7)
else:
    print("ERROR: test failed to build, skipping all the sub tests")

